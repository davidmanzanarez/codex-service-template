PORT=3000
NODE_ENV=development
DEBUG_MODE=false

# Must match your development Hub. Production requires random secrets >=32 chars.
JWT_SECRET=dev-secret-change-me
HUB_SECRET=dev-hub-secret-change-in-production
HUB_PUBLIC_URL=http://localhost:4000
SELF_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Optional: leave blank for multi-user access; set a Hub user ID for owner-only.
OWNER_USER_ID=

# Additional exact origins, comma-separated. No wildcards; HTTPS in production.
CORS_ORIGINS=

# Same parent domain as the Hub cookie in production.
# COOKIE_DOMAIN=.example.com
# DB_PATH=/app/data/my-service.db
# SERVICE_IMAGE=ghcr.io/your-account/your-service@sha256:your-image-digest
